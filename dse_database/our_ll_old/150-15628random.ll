  %inc = add nsw i64 %3, 1
  store i64 %inc, ptr %i, align 8
  br label %for.cond, !llvm.loop !5

for.end:                                          ; preds = %for.cond
  %4 = load i64, ptr %i, align 8
  %call5 = call i32 (ptr, ...) @printf(ptr noundef @.str.3, i64 noundef %4)
  ret i32 0
