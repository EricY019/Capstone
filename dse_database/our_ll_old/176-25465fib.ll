; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @fib(i32 noundef %n) #0 {
entry:
  %n.addr = alloca i32, align 4
  %prev = alloca double, align 8
  %result = alloca double, align 8
  %sum = alloca double, align 8
  %i = alloca i32, align 4
  store i32 %n, ptr %n.addr, align 4
  store double -1.000000e+00, ptr %prev, align 8
  store double 1.000000e+00, ptr %result, align 8
  store i32 0, ptr %i, align 4
  br label %for.cond

for.cond:                                         ; preds = %for.inc, %entry
  %0 = load i32, ptr %i, align 4
  %1 = load i32, ptr %n.addr, align 4
  %cmp = icmp sle i32 %0, %1
  br i1 %cmp, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  %2 = load double, ptr %result, align 8
  %3 = load double, ptr %prev, align 8
  %add = fadd double %2, %3
  store double %add, ptr %sum, align 8
  %4 = load double, ptr %result, align 8
  store double %4, ptr %prev, align 8
  %5 = load double, ptr %sum, align 8
  store double %5, ptr %result, align 8
  br label %for.inc

for.inc:                                          ; preds = %for.body
  %6 = load i32, ptr %i, align 4
  %inc = add nsw i32 %6, 1
  store i32 %inc, ptr %i, align 4
  br label %for.cond, !llvm.loop !5

for.end:                                          ; preds = %for.cond
  %7 = load double, ptr %result, align 8
  %conv = fptosi double %7 to i32
  ret i32 %conv
}

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main(i32 noundef %argc, ptr noundef %argv) #0 {
entry:
  %argc.addr = alloca i32, align 4
  %argv.addr = alloca ptr, align 8
  %i = alloca i32, align 4
  %t = alloca i32, align 4
  store i32 %argc, ptr %argc.addr, align 4
  store ptr %argv, ptr %argv.addr, align 8
  %call = call i32 @fib(i32 noundef 5)
  %call1 = call i32 (ptr, ...) @printf(ptr noundef @.str, i32 noundef %call)
  ret i32 0
}

